{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LinuxZPL (GTK, else Qt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/linuxzpl.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "LinuxZPL (Qt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/linuxzpl.py",
      "args": ["--qt"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "LinuxZPL (GTK)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/linuxzpl.py",
      "args": ["--gtk"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: core",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_core.py",
      "cwd": "${workspaceFolder}",
      "env": { "QT_QPA_PLATFORM": "offscreen" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: deviations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_deviations.py",
      "cwd": "${workspaceFolder}",
      "env": { "QT_QPA_PLATFORM": "offscreen" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: conformance (GTK vs Qt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_conformance.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Conformance driver: GTK",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/conformance_driver.py",
      "args": ["--frontend", "gtk"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Conformance driver: Qt",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/conformance_driver.py",
      "args": ["--frontend", "qt"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
